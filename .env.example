# ──────────────────────────────────────────
#  Base de Datos PostgreSQL
# ──────────────────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=hotel_pms_db

# La URL se construye automáticamente desde las variables anteriores
DATABASE_URL=postgresql://admin:CHANGE_ME_SECURE_PASSWORD@postgres-db:5432/hotel_pms_db

# ──────────────────────────────────────────
#  Seguridad y Autenticación
# ──────────────────────────────────────────
# Genera una clave con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY_32_CHARS

# Hash seguro del PIN de acceso staff (4 dígitos).
# Genera uno con: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('TU_PIN_4_DIGITOS'))"
STAFF_PIN_HASH=scrypt:32768:8:1

# Contraseñas iniciales para sembrado de usuarios administrativos
ADMIN_JHONNY_PASS=CHANGE_ME_JHONNY_PASS
ADMIN_EDWIN_PASS=CHANGE_ME_EDWIN_PASS
RECEP_ANA_PASS=CHANGE_ME_ANA_PASS

# ──────────────────────────────────────────
#  Correo (Gmail / SMTP)
# ──────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu-correo@gmail.com
# Usa una contraseña de aplicación de Google (App Password), NO la normal
# Crea una en: https://myaccount.google.com/apppasswords
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_DEFAULT_SENDER=Hotel PMS <tu-correo@gmail.com>

# ──────────────────────────────────────────
#  Flask
# ──────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=production
FLASK_DEBUG=0
